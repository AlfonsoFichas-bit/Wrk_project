{
	"name": "WorkflowS-project",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rsbuild build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "rsbuild dev --open",
		"dev:server": "npx tsx src/server/index.ts",
		"dev:all": "concurrently npm:dev:server npm:dev",
		"format": "biome format --write",
		"preview": "rsbuild preview",
		"migrate:dev": "prisma migrate dev",
		"migrate:prod": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"switch-db": "scripts\\switch-db.cmd",
		"switch-db:sh": "bash ./scripts/switch-db.sh",
		"lint": "biome check",
		"test": "vitest run --exclude e2e",
		"e2e": "playwright test",
		"test:unit": "vitest run --exclude e2e",
		"test:unit:watch": "vitest"
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@prisma/adapter-better-sqlite3": "^7.1.0",
		"@prisma/adapter-pg": "^7.0.0",
		"@prisma/client": "^7.1.0",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^24.10.1",
		"bcryptjs": "^3.0.3",
		"better-sqlite3": "^12.5.0",
		"clsx": "^2.1.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"express-rate-limit": "^8.5.2",
		"helmet": "^8.2.0",
		"jsonwebtoken": "^9.0.2",
		"lucide-react": "^0.554.0",
		"multer": "^2.0.2",
		"pg": "^8.16.3",
		"playwright": "^1.57.0",
		"postcss": "^8.5.6",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.9.6",
		"recharts": "^3.4.1",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.17",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@playwright/test": "^1.57.0",
		"@rsbuild/core": "^1.6.4",
		"@rsbuild/plugin-react": "^1.4.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/pg": "^8.15.6",
		"@types/react": "^19.2.4",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"prisma": "^7.1.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	},
	"prisma": {
		"seed": "npx tsx prisma/seed.ts"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"better-sqlite3@12.5.0": true,
		"core-js@3.46.0": true,
		"prisma@7.1.0": true,
		"@prisma/engines@7.1.0": true
	}
}
