// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
}

// ===================== MODELS =====================

// Usuario del sistema
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  password         String
  role             String   @default("TEAM_DEVELOPER") // Role
  avatar           String?
  active           Boolean  @default(true)
  tokenVersion     Int      @default(0)
  dashboardModules String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  projects                Project[]
  tasks                   Task[]
  evaluations             Evaluation[]
  userStories             UserStory[]
  messages                Message[]
  chats                   ChatParticipant[]
  projectMemberships      ProjectMember[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  retrospectiveItems      RetrospectiveItem[]

  @@index([email])
  @@map("users")
}

// Proyecto
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE") // ProjectStatus
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  sprints     Sprint[]
  userStories UserStory[]
  tasks       Task[]
  evaluations Evaluation[]
  rubrics     Rubric[]
  chat        Chat[]
  documents   Document[]

  @@index([ownerId])
  @@map("projects")
}

// Documentos
model Document {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  url        String // Simulado
  type       String // PDF, DOCX, etc.
  size       Int? // KB
  version    Int      @default(1)
  parentId   String? // ID del documento original si es una versión
  uploadedAt DateTime @default(now())

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Document?  @relation("DocumentHistory", fields: [parentId], references: [id], onDelete: SetNull)
  versions Document[] @relation("DocumentHistory")

  @@index([projectId])
  @@index([parentId])
  @@map("documents")
}

// Miembros del proyecto
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // ProjectRole
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Sprint
model Sprint {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PLANNING") // SprintStatus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStories        UserStory[]
  tasks              Task[]
  retrospectiveItems RetrospectiveItem[]
  evaluations        Evaluation[]

  @@index([projectId])
  @@map("sprints")
}

// User Story
model UserStory {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String
  acceptance  String?
  priority    String    @default("MEDIUM") // Priority
  storyPoints Int?
  status      String    @default("BACKLOG") // UserStoryStatus
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId_userId String?
  assigneeId       String?
  assignee         User?   @relation(fields: [assigneeId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([sprintId])
  @@map("user_stories")
}

// Tarea
model Task {
  id          String    @id @default(cuid())
  projectId   String
  userStoryId String?
  sprintId    String?
  title       String
  description String?
  priority    String    @default("MEDIUM") // Priority
  status      String    @default("TODO") // TaskStatus
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStory   UserStory?   @relation(fields: [userStoryId], references: [id])
  sprint      Sprint?      @relation(fields: [sprintId], references: [id])
  evaluations Evaluation[]

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

// Rúbrica de evaluación
model Rubric {
  id          String     @id @default(cuid())
  projectId   String?
  name        String
  description String?
  criteria    Criteria[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("rubrics")
}

// Criterios de evaluación
model Criteria {
  id          String  @id @default(cuid())
  rubricId    String
  name        String
  description String?
  maxScore    Int     @default(100)
  weight      Int     @default(1)

  rubric      Rubric               @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evaluations EvaluationCriteria[]

  @@index([rubricId])
  @@map("criteria")
}

// Evaluación
model Evaluation {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  sprintId    String?
  evaluatorId String
  status      String   @default("PENDING") // EvaluationStatus
  feedback    String?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sprint    Sprint?              @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  evaluator User                 @relation(fields: [evaluatorId], references: [id])
  criteria  EvaluationCriteria[]

  @@index([projectId])
  @@index([taskId])
  @@index([sprintId])
  @@index([evaluatorId])
  @@map("evaluations")
}

// Detalles de evaluación por criterio
model EvaluationCriteria {
  id           String  @id @default(cuid())
  evaluationId String
  criteriaId   String
  score        Int     @default(0)
  comment      String?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criteria   Criteria   @relation(fields: [criteriaId], references: [id])

  @@unique([evaluationId, criteriaId])
  @@map("evaluation_criteria")
}

// Chat y conversaciones
model Chat {
  id        String   @id @default(cuid())
  projectId String?
  title     String?
  type      String   @default("PROJECT") // PROJECT, DIRECT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ChatParticipant[]

  @@index([projectId])
  @@map("chats")
}

model ChatParticipant {
  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("chat_participants")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("messages")
}

// Notificaciones
enum NotificationType {
  TASK_ASSIGNED
  USER_STORY_ASSIGNED
  EVALUATION_COMPLETED
  MESSAGE
  PROJECT_ASSIGNED
  RETROSPECTIVE_ITEM
  SPRINT_COMPLETED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  entityType String?
  entityId   String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  enabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// Retrospectiva
model RetrospectiveItem {
  id        String   @id @default(cuid())
  sprintId  String
  type      String // GOOD, BAD, ACTION
  content   String
  userId    String
  createdAt DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@map("retrospective_items")
}
